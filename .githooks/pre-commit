#!/usr/bin/env bash
# Pre-commit hook for hoop-smart-kids
set -e

echo "🔍 Hoop Smart Kids pre-commit checks..."

# 1. Lint check
echo "🧹 Running oxlint..."
npm run lint 2>&1
echo "✅ Lint OK"

# 2. Build check
echo "📦 Building..."
npm run build 2>&1 | tail -5
if [ $? -ne 0 ]; then
  echo "❌ BUILD FAILED. Commit blocked."
  exit 1
fi
echo "✅ Build OK"

# 3. Validate court coordinate conventions
echo "🧮 Validating court coordinates..."
node .github/scripts/validate-court.mjs

echo "🎉 All checks passed!"
